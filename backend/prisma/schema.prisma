generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      String    @default("CLIENT")
  phone     String?
  avatar    String?
  addresses Address[]
  cart      CartItem[]
  wishlist  Wishlist[]
  orders    Order[]
  reviews   Review[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id          Int     @id @default(autoincrement())
  user        User    @relation(fields:[userId], references:[id], onDelete:Cascade)
  userId      Int
  name        String
  phone       String
  governorate String
  area        String
  building    String
  street      String
  notes       String?
  isDefault   Boolean @default(false)
}

model Seller {
  id              Int       @id @default(autoincrement())
  name            String
  slug            String    @unique
  logo            String
  color           String    @default("#2563EB")
  rating          Float     @default(4.5)
  reviewsCount    Int       @default(0)
  verified        Boolean   @default(false)
  badge           String    @default("Nouveau")
  location        String
  joinedYear      Int
  productsCount   Int       @default(0)
  responseTime    String    @default("sous 24 heures")
  // Auth
  email           String?   @unique
  password        String?
  phone           String?
  description     String?
  bannerColor     String?
  isActive        Boolean   @default(true)
  // Informations légales / KYC
  formeJuridique  String?
  rc              String?
  patente         String?
  adresseComplete String?
  gerant          String?
  cinGerant       String?
  qualiteSignataire String?
  banque          String?
  rib             String?
  categorieAutorisee String?
  // Documents uploadés
  docCin          String?   // URL scan CIN/Passeport gérant
  docRc           String?   // URL Registre de Commerce
  docPatente      String?   // URL Patente
  docRib          String?   // URL Relevé d'identité bancaire
  products        Product[]
  application     VendorApplication?
  paymentCycles   PaymentCycle[]
  contract        Contract?
}

model Category {
  id         Int                 @id @default(autoincrement())
  name       String
  slug       String              @unique
  icon       String
  parentId   Int?
  isVisible  Boolean             @default(true)
  sortOrder  Int                 @default(0)
  parent     Category?           @relation("CategoryTree", fields:[parentId], references:[id])
  children   Category[]          @relation("CategoryTree")
  products   Product[]
  attributes CategoryAttribute[]
}

model CategoryAttribute {
  id         Int      @id @default(autoincrement())
  category   Category @relation(fields:[categoryId], references:[id])
  categoryId Int
  name       String
  slug       String
  type       String   @default("TEXT")
  options    String   @default("[]")
  isRequired Boolean  @default(false)
  sortOrder  Int      @default(0)
}

model Product {
  id              Int         @id @default(autoincrement())
  title           String
  brand           String
  seller          Seller      @relation(fields:[sellerId], references:[id])
  sellerId        Int
  category        Category    @relation(fields:[categoryId], references:[id])
  categoryId      Int
  subcategory     String
  price           Float
  originalPrice   Float
  discount        Int         @default(0)
  description     String
  specifications  String      @default("{}")
  variants        String      @default("{}")
  images          String      @default("[]")
  stock           Int         @default(100)
  lowStock        Boolean     @default(false)
  rating          Float       @default(4.5)
  reviewsCount    Int         @default(0)
  soldCount       Int         @default(0)
  tags            String      @default("[]")
  sku             String?
  warranty        String      @default("1 an")
  returnPolicy    String      @default("Retour 15 jours")
  expressDelivery Boolean     @default(true)
  freeDelivery    Boolean     @default(true)
  status          String      @default("PENDING")
  isActive        Boolean     @default(false)
  cartItems       CartItem[]
  wishlistItems   Wishlist[]
  orderItems      OrderItem[]
  reviews         Review[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields:[userId], references:[id], onDelete:Cascade)
  userId    Int
  product   Product  @relation(fields:[productId], references:[id])
  productId Int
  qty       Int      @default(1)
  variant   String   @default("{}")
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields:[userId], references:[id], onDelete:Cascade)
  userId    Int
  product   Product  @relation(fields:[productId], references:[id])
  productId Int
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id              Int              @id @default(autoincrement())
  user            User             @relation(fields:[userId], references:[id])
  userId          Int
  status          String           @default("EN_ATTENTE")
  total           Float
  subtotal        Float
  discount        Float            @default(0)
  shippingCost    Float            @default(0)
  vat             Float            @default(0)
  promoCode       String?
  shippingAddress String
  paymentMethod   String
  trackingNumber  String?
  escrowStatus    String           @default("HELD")
  releasedAt      DateTime?
  items           OrderItem[]
  dispute         Dispute?
  events          OrderEvent[]
  returnRequest   ReturnRequest?
  fulfillments    OrderFulfillment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model OrderFulfillment {
  id             Int      @id @default(autoincrement())
  order          Order    @relation(fields:[orderId], references:[id])
  orderId        Int
  sellerId       Int
  status         String   @default("EN_ATTENTE") // EN_ATTENTE | EN_PREPARATION | EXPEDIEE | LIVREE
  trackingNumber String?
  note           String?
  shipment       Shipment?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([orderId, sellerId])
}

model OrderEvent {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields:[orderId], references:[id])
  orderId   Int
  status    String
  note      String   @default("")
  createdBy String   @default("SYSTEM")
  createdAt DateTime @default(now())
}

model ReturnRequest {
  id          Int      @id @default(autoincrement())
  order       Order    @relation(fields:[orderId], references:[id])
  orderId     Int      @unique
  userId      Int
  sellerId    Int
  reason      String
  description String   @default("")
  status      String   @default("PENDING")
  resolution  String?
  resolvedBy  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id        Int       @id @default(autoincrement())
  userId    Int
  sellerId  Int
  productId Int?
  subject   String    @default("")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, sellerId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversation   Conversation @relation(fields:[conversationId], references:[id])
  conversationId Int
  senderId       Int
  senderType     String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model LoyaltyPoint {
  id        Int      @id @default(autoincrement())
  userId    Int
  points    Int
  type      String
  orderId   Int?
  note      String   @default("")
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  sellerId  Int?
  type      String
  title     String
  message   String
  link      String   @default("")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields:[orderId], references:[id])
  orderId   Int
  product   Product @relation(fields:[productId], references:[id])
  productId Int
  qty       Int
  price     Float
  variant   String  @default("{}")
}

model Review {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields:[userId], references:[id])
  userId    Int
  product   Product  @relation(fields:[productId], references:[id])
  productId Int
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model PromoCode {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  discount Float
  isActive Boolean @default(true)
  uses     Int     @default(0)
}

model AdminUser {
  id                 Int        @id @default(autoincrement())
  name               String
  email              String     @unique
  password           String
  role               String     @default("SUPPORT")
  permissions        String     @default("[]")
  twoFactorEnabled   Boolean    @default(false)
  twoFactorSecret    String?
  isActive           Boolean    @default(true)
  lastLogin          DateTime?
  createdAt          DateTime   @default(now())
  logs               AdminLog[]
}

model AdminLog {
  id        Int       @id @default(autoincrement())
  admin     AdminUser @relation(fields:[adminId], references:[id])
  adminId   Int
  action    String
  module    String
  targetId  String    @default("")
  details   String    @default("{}")
  ip        String    @default("")
  createdAt DateTime  @default(now())
}

model VendorApplication {
  id               Int      @id @default(autoincrement())
  seller           Seller   @relation(fields:[sellerId], references:[id])
  sellerId         Int      @unique
  status           String   @default("PENDING")
  companyName      String?
  taxId            String?
  bankAccount      String?
  idDocument       String?
  rejectionReason  String?
  reviewedBy       Int?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
}

model Commission {
  id         Int      @id @default(autoincrement())
  type       String   @default("GLOBAL")
  sellerId   Int?
  categoryId Int?
  rate       Float    @default(0.10)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Dispute {
  id          Int      @id @default(autoincrement())
  order       Order    @relation(fields:[orderId], references:[id])
  orderId     Int      @unique
  userId      Int
  sellerId    Int
  reason      String
  description String
  status      String   @default("OPEN")
  resolution  String?
  resolvedBy  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id          Int      @id @default(autoincrement())
  type        String   @default("HERO")   // HERO = slider principal | PROMO = mini-cartes homepage
  title       String
  subtitle    String   @default("")
  description String   @default("")
  ctaText     String   @default("Découvrir")
  catSlug     String   @default("")
  sellerSlug  String   @default("")
  bgFrom      String   @default("#1E3A8A")
  bgTo        String   @default("#2563EB")
  bgImageUrl  String   @default("")
  emoji       String   @default("🎉")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model FlashSale {
  id          Int      @id @default(autoincrement())
  name        String
  startAt     DateTime
  endAt       DateTime
  discountPct Int
  isActive    Boolean  @default(true)
  productIds  String   @default("[]")
  createdAt   DateTime @default(now())
}

model PlatformSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  group     String   @default("GENERAL")
  updatedAt DateTime @updatedAt
}

model Contract {
  id                   Int       @id @default(autoincrement())
  seller               Seller    @relation(fields:[sellerId], references:[id])
  sellerId             Int       @unique
  ref                  String    @unique
  status               String    @default("DRAFT")  // DRAFT | SENT | SIGNED | TERMINATED
  // Conditions tarifaires
  tauxCommission       Float     @default(10)
  montantAbonnement    Float     @default(0)
  tarifMiseEnAvant     Float     @default(0)
  tauxRetenueSource    Float     @default(0)
  frequenceVersement   String    @default("Mensuel")
  seuilVersement       Float     @default(100)
  delaiMiseEnDemeure   Int       @default(5)
  delaiPreavisTarif    Int       @default(30)
  delaiPreavisResiliation Int    @default(30)
  delaiRegularisation  Int       @default(15)
  delaiSoldeCompte     Int       @default(15)
  dureeInitiale        Int       @default(12)
  // Dates
  dateDebut            DateTime?
  dateSignatureClient  DateTime?
  dateSignatureMarket  DateTime?
  // Acceptation électronique
  logAcceptanceRef     String?
  signedByIp           String?
  // Suivi
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model PaymentCycle {
  id          Int      @id @default(autoincrement())
  seller      Seller   @relation(fields:[sellerId], references:[id])
  sellerId    Int
  periodStart DateTime
  periodEnd   DateTime
  grossAmount Float
  commission  Float
  netAmount   Float
  status      String   @default("PENDING")
  paidAt      DateTime?
  createdAt   DateTime @default(now())
}

// ── MODULE LIVRAISON & LOGISTIQUE ─────────────────────────────────────────────

model Shipment {
  id                Int               @id @default(autoincrement())
  // Lien vers OrderFulfillment (1-to-1 optionnel)
  fulfillmentId     Int?              @unique
  fulfillment       OrderFulfillment? @relation(fields:[fulfillmentId], references:[id])
  orderId           Int
  sellerId          Int
  // Mode et statut
  mode              String            @default("FLEET") // FLEET | THIRD_PARTY
  status            String            @default("DRAFT")
  // Caractéristiques physiques
  weightKg          Float             @default(0)
  isFragile         Boolean           @default(false)
  declaredValue     Float             @default(0)
  // COD
  isCod             Boolean           @default(false)
  codAmount         Float             @default(0)
  // SLA
  isExpress         Boolean           @default(false)
  estimatedDelivery DateTime?
  // Adresses JSON
  pickupAddress     String            @default("{}")
  deliveryAddress   String            @default("{}")
  // Routage
  routingRationale  String            @default("")
  // Suivi
  trackingRef       String?           @unique
  // Affectation flotte
  tourId            Int?
  tour              Tour?             @relation(fields:[tourId], references:[id])
  driverId          Int?
  driver            Driver?           @relation(fields:[driverId], references:[id])
  vehicleId         Int?
  vehicle           Vehicle?          @relation(fields:[vehicleId], references:[id])
  // Affectation 3PL
  carrierId         Int?
  carrier           Carrier?          @relation(fields:[carrierId], references:[id])
  // Relations
  events            ShipmentEvent[]
  codCollection     CodCollection?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ShipmentEvent {
  id         Int      @id @default(autoincrement())
  shipment   Shipment @relation(fields:[shipmentId], references:[id])
  shipmentId Int
  status     String
  note       String   @default("")
  createdBy  String   @default("SYSTEM")
  actorId    Int?
  lat        Float?
  lng        Float?
  createdAt  DateTime @default(now())
}

// Zones géographiques couvertes par la flotte propre
model FleetZone {
  id          Int     @id @default(autoincrement())
  governorate String  @unique
  mode        String  @default("FLEET") // FLEET | HYBRID | THIRD_PARTY
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
}

model Vehicle {
  id          Int          @id @default(autoincrement())
  plate       String       @unique
  brand       String
  model       String       @default("")
  type        String       @default("VL") // VL | VUL | PL | MOTO
  ptacKg      Float        @default(3500)
  capacityKg  Float        @default(500)
  capacityL   Float        @default(1000)
  status      String       @default("ACTIVE") // ACTIVE | MAINTENANCE | OUT_OF_SERVICE
  assignedDriverId Int?
  docs        VehicleDoc[]
  shipments   Shipment[]
  tours       Tour[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model VehicleDoc {
  id         Int      @id @default(autoincrement())
  vehicle    Vehicle  @relation(fields:[vehicleId], references:[id], onDelete:Cascade)
  vehicleId  Int
  type       String   // CARTE_GRISE | ASSURANCE | VISITE_TECHNIQUE | VIGNETTE | AUTORISATION_MT | ATT
  url        String
  expiresAt  DateTime?
  isExpired  Boolean  @default(false)
  alertSent  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Driver {
  id          Int           @id @default(autoincrement())
  name        String
  phone       String
  cin         String        @unique
  licenseNo   String
  licenseType String        @default("B") // B | C | EC
  status      String        @default("ACTIVE") // ACTIVE | OFF | SUSPENDED
  codBalance  Float         @default(0)
  password    String?       // bcrypt — accès PWA chauffeur
  docs        DriverDoc[]
  shipments   Shipment[]
  tours       Tour[]
  settlements CodSettlement[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model DriverDoc {
  id         Int      @id @default(autoincrement())
  driver     Driver   @relation(fields:[driverId], references:[id], onDelete:Cascade)
  driverId   Int
  type       String   // PERMIS | CIN | VISITE_MEDICALE
  url        String
  expiresAt  DateTime?
  isExpired  Boolean  @default(false)
  alertSent  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Tour {
  id           Int             @id @default(autoincrement())
  date         DateTime
  driver       Driver          @relation(fields:[driverId], references:[id])
  driverId     Int
  vehicle      Vehicle         @relation(fields:[vehicleId], references:[id])
  vehicleId    Int
  status       String          @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  kmEstimated  Float           @default(0)
  kmActual     Float           @default(0)
  departAt     DateTime?
  returnAt     DateTime?
  codTotal     Float           @default(0)
  codCollected Float           @default(0)
  notes        String          @default("")
  stops        TourStop[]
  shipments    Shipment[]
  settlements  CodSettlement[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model TourStop {
  id         Int      @id @default(autoincrement())
  tour       Tour     @relation(fields:[tourId], references:[id])
  tourId     Int
  shipmentId Int
  position   Int      @default(0)
  status     String   @default("PENDING") // PENDING | DONE | FAILED | SKIPPED
  failReason String   @default("")
  notes      String   @default("")
  doneAt     DateTime?
  createdAt  DateTime @default(now())
}

model Carrier {
  id           Int               @id @default(autoincrement())
  name         String
  slug         String            @unique
  nif          String            @default("")
  rne          String            @default("")
  phone        String            @default("")
  email        String            @default("")
  type         String            @default("NATIONAL") // NATIONAL | INTERNATIONAL | EXPRESS | COLD_CHAIN
  status       String            @default("ACTIVE") // ACTIVE | INACTIVE | KYC_PENDING
  contracts    CarrierContract[]
  pricingGrids PricingGrid[]
  shipments    Shipment[]
  invoices     CarrierInvoice[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model CarrierContract {
  id          Int      @id @default(autoincrement())
  carrier     Carrier  @relation(fields:[carrierId], references:[id])
  carrierId   Int
  ref         String   @unique
  status      String   @default("ACTIVE") // DRAFT | ACTIVE | TERMINATED
  startDate   DateTime
  endDate     DateTime?
  billingMode String   @default("PER_SHIPMENT") // PER_SHIPMENT | MONTHLY
  slaDays     Int      @default(3)
  penaltyPct  Float    @default(0)
  docUrl      String   @default("")
  createdAt   DateTime @default(now())
}

model PricingGrid {
  id           Int     @id @default(autoincrement())
  carrier      Carrier @relation(fields:[carrierId], references:[id])
  carrierId    Int
  governorate  String  @default("ALL")
  minWeightKg  Float   @default(0)
  maxWeightKg  Float   @default(30)
  basePrice    Float
  codSurcharge Float   @default(0)
  fragileExtra Float   @default(0)
  expressExtra Float   @default(0)
  createdAt    DateTime @default(now())
}

model CarrierInvoice {
  id          Int      @id @default(autoincrement())
  carrier     Carrier  @relation(fields:[carrierId], references:[id])
  carrierId   Int
  ref         String
  amount      Float
  status      String   @default("PENDING") // PENDING | MATCHED | PAID | DISPUTED
  periodStart DateTime
  periodEnd   DateTime
  docUrl      String   @default("")
  createdAt   DateTime @default(now())
}

model ShippingRule {
  id           Int      @id @default(autoincrement())
  name         String
  governorate  String   @default("ALL")
  sellerId     Int?
  freeAbove    Float    @default(200)
  basePrice    Float    @default(25)
  expressExtra Float    @default(15)
  isActive     Boolean  @default(true)
  priority     Int      @default(0)
  createdAt    DateTime @default(now())
}

model CodCollection {
  id           Int            @id @default(autoincrement())
  shipment     Shipment       @relation(fields:[shipmentId], references:[id])
  shipmentId   Int            @unique
  driverId     Int
  amount       Float
  method       String         @default("CASH") // CASH | TPE
  signatureUrl String         @default("")
  photoUrl     String         @default("")
  collectedAt  DateTime       @default(now())
  settlementId Int?
  settlement   CodSettlement? @relation(fields:[settlementId], references:[id])
}

model CodSettlement {
  id            Int             @id @default(autoincrement())
  driver        Driver          @relation(fields:[driverId], references:[id])
  driverId      Int
  tour          Tour?           @relation(fields:[tourId], references:[id])
  tourId        Int?
  carrierId     Int?
  totalExpected Float
  totalActual   Float
  diff          Float           @default(0)
  status        String          @default("PENDING") // PENDING | VALIDATED | DISPUTED
  validatedBy   Int?
  validatedAt   DateTime?
  notes         String          @default("")
  collections   CodCollection[]
  createdAt     DateTime        @default(now())
}

model ComplianceAlert {
  id          Int      @id @default(autoincrement())
  type        String   // VEHICLE_DOC | DRIVER_DOC
  entityType  String   // VEHICLE | DRIVER
  entityId    Int
  docType     String
  expiresAt   DateTime
  daysLeft    Int
  severity    String   @default("INFO") // INFO | WARNING | CRITICAL | EXPIRED
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())
}
