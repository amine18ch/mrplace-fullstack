generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      String    @default("CLIENT")
  phone     String?
  avatar    String?
  addresses Address[]
  cart      CartItem[]
  wishlist  Wishlist[]
  orders    Order[]
  reviews   Review[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id          Int     @id @default(autoincrement())
  user        User    @relation(fields:[userId], references:[id], onDelete:Cascade)
  userId      Int
  name        String
  phone       String
  governorate String
  area        String
  building    String
  street      String
  notes       String?
  isDefault   Boolean @default(false)
}

model Seller {
  id            Int       @id @default(autoincrement())
  name          String
  slug          String    @unique
  logo          String
  color         String    @default("#2563EB")
  rating        Float     @default(4.5)
  reviewsCount  Int       @default(0)
  verified      Boolean   @default(false)
  badge         String    @default("Nouveau")
  location      String
  joinedYear    Int
  productsCount Int       @default(0)
  responseTime  String    @default("sous 24 heures")
  // Seller auth
  email         String?   @unique
  password      String?
  phone         String?
  description   String?
  bannerColor   String?
  isActive      Boolean   @default(true)
  products      Product[]
  application   VendorApplication?
  paymentCycles PaymentCycle[]
}

model Category {
  id         Int                 @id @default(autoincrement())
  name       String
  slug       String              @unique
  icon       String
  parentId   Int?
  isVisible  Boolean             @default(true)
  sortOrder  Int                 @default(0)
  parent     Category?           @relation("CategoryTree", fields:[parentId], references:[id])
  children   Category[]          @relation("CategoryTree")
  products   Product[]
  attributes CategoryAttribute[]
}

model CategoryAttribute {
  id         Int      @id @default(autoincrement())
  category   Category @relation(fields:[categoryId], references:[id])
  categoryId Int
  name       String
  slug       String
  type       String   @default("TEXT")
  options    String   @default("[]")
  isRequired Boolean  @default(false)
  sortOrder  Int      @default(0)
}

model Product {
  id              Int         @id @default(autoincrement())
  title           String
  brand           String
  seller          Seller      @relation(fields:[sellerId], references:[id])
  sellerId        Int
  category        Category    @relation(fields:[categoryId], references:[id])
  categoryId      Int
  subcategory     String
  price           Float
  originalPrice   Float
  discount        Int         @default(0)
  description     String
  specifications  String      @default("{}")
  variants        String      @default("{}")
  images          String      @default("[]")
  stock           Int         @default(100)
  lowStock        Boolean     @default(false)
  rating          Float       @default(4.5)
  reviewsCount    Int         @default(0)
  soldCount       Int         @default(0)
  tags            String      @default("[]")
  sku             String?
  warranty        String      @default("1 an")
  returnPolicy    String      @default("Retour 15 jours")
  expressDelivery Boolean     @default(true)
  freeDelivery    Boolean     @default(true)
  status          String      @default("PENDING")
  isActive        Boolean     @default(false)
  cartItems       CartItem[]
  wishlistItems   Wishlist[]
  orderItems      OrderItem[]
  reviews         Review[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields:[userId], references:[id], onDelete:Cascade)
  userId    Int
  product   Product  @relation(fields:[productId], references:[id])
  productId Int
  qty       Int      @default(1)
  variant   String   @default("{}")
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields:[userId], references:[id], onDelete:Cascade)
  userId    Int
  product   Product  @relation(fields:[productId], references:[id])
  productId Int
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id              Int              @id @default(autoincrement())
  user            User             @relation(fields:[userId], references:[id])
  userId          Int
  status          String           @default("EN_ATTENTE")
  total           Float
  subtotal        Float
  discount        Float            @default(0)
  shippingCost    Float            @default(0)
  vat             Float            @default(0)
  promoCode       String?
  shippingAddress String
  paymentMethod   String
  trackingNumber  String?
  escrowStatus    String           @default("HELD")
  releasedAt      DateTime?
  items           OrderItem[]
  dispute         Dispute?
  events          OrderEvent[]
  returnRequest   ReturnRequest?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model OrderEvent {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields:[orderId], references:[id])
  orderId   Int
  status    String
  note      String   @default("")
  createdBy String   @default("SYSTEM")
  createdAt DateTime @default(now())
}

model ReturnRequest {
  id          Int      @id @default(autoincrement())
  order       Order    @relation(fields:[orderId], references:[id])
  orderId     Int      @unique
  userId      Int
  sellerId    Int
  reason      String
  description String   @default("")
  status      String   @default("PENDING")
  resolution  String?
  resolvedBy  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id        Int       @id @default(autoincrement())
  userId    Int
  sellerId  Int
  productId Int?
  subject   String    @default("")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, sellerId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversation   Conversation @relation(fields:[conversationId], references:[id])
  conversationId Int
  senderId       Int
  senderType     String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model LoyaltyPoint {
  id        Int      @id @default(autoincrement())
  userId    Int
  points    Int
  type      String
  orderId   Int?
  note      String   @default("")
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  sellerId  Int?
  type      String
  title     String
  message   String
  link      String   @default("")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields:[orderId], references:[id])
  orderId   Int
  product   Product @relation(fields:[productId], references:[id])
  productId Int
  qty       Int
  price     Float
  variant   String  @default("{}")
}

model Review {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields:[userId], references:[id])
  userId    Int
  product   Product  @relation(fields:[productId], references:[id])
  productId Int
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model PromoCode {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  discount Float
  isActive Boolean @default(true)
  uses     Int     @default(0)
}

model AdminUser {
  id                 Int        @id @default(autoincrement())
  name               String
  email              String     @unique
  password           String
  role               String     @default("SUPPORT")
  permissions        String     @default("[]")
  twoFactorEnabled   Boolean    @default(false)
  twoFactorSecret    String?
  isActive           Boolean    @default(true)
  lastLogin          DateTime?
  createdAt          DateTime   @default(now())
  logs               AdminLog[]
}

model AdminLog {
  id        Int       @id @default(autoincrement())
  admin     AdminUser @relation(fields:[adminId], references:[id])
  adminId   Int
  action    String
  module    String
  targetId  String    @default("")
  details   String    @default("{}")
  ip        String    @default("")
  createdAt DateTime  @default(now())
}

model VendorApplication {
  id               Int      @id @default(autoincrement())
  seller           Seller   @relation(fields:[sellerId], references:[id])
  sellerId         Int      @unique
  status           String   @default("PENDING")
  companyName      String?
  taxId            String?
  bankAccount      String?
  idDocument       String?
  rejectionReason  String?
  reviewedBy       Int?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
}

model Commission {
  id         Int      @id @default(autoincrement())
  type       String   @default("GLOBAL")
  sellerId   Int?
  categoryId Int?
  rate       Float    @default(0.10)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Dispute {
  id          Int      @id @default(autoincrement())
  order       Order    @relation(fields:[orderId], references:[id])
  orderId     Int      @unique
  userId      Int
  sellerId    Int
  reason      String
  description String
  status      String   @default("OPEN")
  resolution  String?
  resolvedBy  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id          Int      @id @default(autoincrement())
  title       String
  subtitle    String   @default("")
  description String   @default("")
  ctaText     String   @default("Découvrir")
  catSlug     String   @default("")
  bgFrom      String   @default("#1E3A8A")
  bgTo        String   @default("#2563EB")
  emoji       String   @default("🎉")
  imageUrl    String   @default("")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model FlashSale {
  id          Int      @id @default(autoincrement())
  name        String
  startAt     DateTime
  endAt       DateTime
  discountPct Int
  isActive    Boolean  @default(true)
  productIds  String   @default("[]")
  createdAt   DateTime @default(now())
}

model PlatformSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  group     String   @default("GENERAL")
  updatedAt DateTime @updatedAt
}

model PaymentCycle {
  id          Int      @id @default(autoincrement())
  seller      Seller   @relation(fields:[sellerId], references:[id])
  sellerId    Int
  periodStart DateTime
  periodEnd   DateTime
  grossAmount Float
  commission  Float
  netAmount   Float
  status      String   @default("PENDING")
  paidAt      DateTime?
  createdAt   DateTime @default(now())
}
